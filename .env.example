# Credenciais da Open API de Afiliados da Shopee.
# Painel de afiliados > Open API > gerar App ID e App Secret.
# Copie este arquivo para .env e preencha.

SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Opcional: caminho de um Chrome do sistema, caso o download do Chromium
# do Playwright esteja bloqueado na sua rede.
# SHOPEEOPS_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
